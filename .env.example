# Copy to .env for local non-Docker development. Do not commit real values.
APP_ENV=development
APP_TIMEZONE=Europe/Istanbul
LOG_LEVEL=INFO
# Host port exposed by the local Docker Compose PostgreSQL service. Change only if 5433 is busy.
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/intelligence
# Production alternative: mount a root-readable secret and set DATABASE_URL_FILE=/run/secrets/database_url.
# Do not set both the value and *_FILE variants; the value is used only when no file is configured.
DATABASE_URL_FILE=
# Optional custom CA bundle for a remote production PostgreSQL endpoint.
DATABASE_SSL_CA_FILE=
# Production uses distinct URLs: owner/migrator for the one-shot migration service and a
# least-privilege runtime role for the app. Keep both files outside the repository.
DATABASE_MIGRATION_URL_FILE=
DATABASE_RUNTIME_URL_FILE=
POSTGRES_DB=intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-before-production
ADMIN_SOURCES_PATH=config/sources.example.yaml
ADMIN_MODELS_PATH=config/models.example.yaml
ADMIN_INTERESTS_PATH=config/interests.example.yaml

# Reserved for later milestones; tests do not require any external credentials.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_FILE=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Personal Intelligence System
# Separate read-only orchestration Agent API. It is disabled unless explicitly enabled, and never
# reuses the Admin password. Prefer AGENT_API_TOKEN_FILE in production; keep the token out of Git.
AGENT_API_ENABLED=false
AGENT_API_TOKEN=
AGENT_API_TOKEN_FILE=
AGENT_API_RATE_LIMIT_PER_MINUTE=30
AGENT_API_AUTH_RATE_LIMIT_PER_MINUTE=10
AGENT_API_MAX_REQUEST_BYTES=2048
AGENT_API_MAX_RESPONSE_BYTES=65536
# Generate once and keep stable: .\.venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This is a URL-safe base64 Fernet key. Never commit it or change it after connecting Gmail accounts.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_FILE=
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_CLIENT_SECRET_FILE=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/admin/gmail/callback
# Optional bounded sync controls; no mailbox-wide scan is performed.
GMAIL_INITIAL_LOOKBACK_HOURS=48
GMAIL_INITIAL_MAX_MESSAGES=25
GMAIL_REQUEST_TIMEOUT_SECONDS=15
GMAIL_MAX_RETRIES=2
SCHEDULER_ENABLED=false
SCHEDULER_DAILY_TIME=08:00
# Independent database maintenance; enable only after the backup/legal-retention plan is approved.
RETENTION_ENABLED=false
PUBLIC_RAW_CONTENT_RETENTION_DAYS=30
OPERATIONAL_RETENTION_DAYS=90
RETENTION_INTERVAL_HOURS=24
# Local admin defaults deliberately stay simple. Production must set all of the following:
# ADMIN_AUTH_ENABLED=true, a unique ADMIN_USERNAME, and a >=16-character ADMIN_PASSWORD
# (or ADMIN_PASSWORD_FILE); ADMIN_PUBLIC_ORIGIN and GMAIL_OAUTH_REDIRECT_URI must be HTTPS.
ADMIN_AUTH_ENABLED=false
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PASSWORD_FILE=
ADMIN_AUTH_RATE_LIMIT_PER_MINUTE=10
ADMIN_PUBLIC_ORIGIN=
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Keep local feed fixtures/HTTP sources possible. Production requires both false.
ALLOW_PRIVATE_SOURCE_URLS=true
ALLOW_INSECURE_SOURCE_URLS=true
RSS_MAX_ITEMS_PER_FEED=100
# Full articles are fetched only after the gatekeeper requests them; these keep the fetch bounded.
ARTICLE_REQUEST_TIMEOUT_SECONDS=12
ARTICLE_MAX_RESPONSE_BYTES=3000000
ARTICLE_MAX_RETRIES=1
# Enable only behind a TLS reverse proxy that supplies X-Forwarded-Proto: https.
FORCE_HTTPS=false
# Only these direct peers may supply X-Forwarded-Proto. Keep the app bound to loopback.
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Notifications are off by default. Prefer a protected self-hosted HTTPS ntfy server and a token.
NTFY_ENABLED=false
NTFY_BASE_URL=
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_TOKEN_FILE=
# ntfy.sh is public by default; requires this explicit acknowledgement and a 32+ character topic.
NTFY_ALLOW_PUBLIC_TOPIC=false
NTFY_REQUEST_TIMEOUT_SECONDS=10
NTFY_MAX_RETRIES=1
# Telegram Bot API is disabled by default. Production needs the optional
# compose.telegram.production.yaml mount and only absolute external secret files.
TELEGRAM_ENABLED=false
TELEGRAM_MODE=webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_FILE=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET_FILE=
TELEGRAM_WEBHOOK_URL=
# Exact user_id:chat_id pairs; do not use separate cross-product allow-lists.
TELEGRAM_ALLOWED_ACTOR_PAIRS=
# Optional notification destinations; each must be an allowed chat above.
TELEGRAM_NOTIFICATION_CHAT_IDS=
TELEGRAM_MAX_REQUEST_BYTES=8192
TELEGRAM_COMMAND_MAX_CHARS=500
TELEGRAM_RATE_LIMIT_PER_MINUTE=10
TELEGRAM_GLOBAL_RATE_LIMIT_PER_MINUTE=20
TELEGRAM_MAX_CONCURRENT_COMMANDS=1
TELEGRAM_COMMAND_TIMEOUT_SECONDS=25
TELEGRAM_PROCESSING_LEASE_SECONDS=90
TELEGRAM_REQUEST_TIMEOUT_SECONDS=10
TELEGRAM_MAX_RETRIES=1
TELEGRAM_POLLING_TIMEOUT_SECONDS=30
TELEGRAM_POLLING_BATCH_LIMIT=25
TELEGRAM_POLLING_MAX_BACKOFF_SECONDS=30
