# Copy to .env for local non-Docker development. Do not commit real values.
APP_ENV=development
APP_TIMEZONE=Europe/Istanbul
LOG_LEVEL=INFO
# Host port exposed by the local Docker Compose PostgreSQL service. Change only if 5433 is busy.
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/intelligence

# Reserved for later milestones; tests do not require any external credentials.
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Personal Intelligence System
APP_ENCRYPTION_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
