# Runtime
APP_ENV=development
APP_TIMEZONE=Europe/Istanbul
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/intelligence

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Personal Intelligence System

# Token encryption for locally persisted OAuth refresh tokens
APP_ENCRYPTION_KEY=

# Optional delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
